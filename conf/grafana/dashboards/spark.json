    {
      "id": 12,
      "type": "timeseries",
      "title": "Input rate vs processing rate (rows/s)",
      "description": "processing < input kéo dài => stream đang bị tụt lại",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 39,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "label_replace({__name__=~\"metrics_.+_driver_spark_streaming_.+_inputRate_total_Value\"}, \"query\", \"$1\", \"__name__\", \"metrics_.+_driver_spark_streaming_(.+)_inputRate_total_Value\")",
          "legendFormat": "{{query}} input",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "label_replace({__name__=~\"metrics_.+_driver_spark_streaming_.+_processingRate_total_Value\"}, \"query\", \"$1\", \"__name__\", \"metrics_.+_driver_spark_streaming_(.+)_processingRate_total_Value\")",
          "legendFormat": "{{query}} processed",
          "refId": "B"
