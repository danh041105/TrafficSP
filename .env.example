# Copy this file to .env for a NEW local environment and replace every <...>.
# Keep .env private. Values below are placeholders, not shared credentials.
# PostgreSQL initialization creates both airflow and iceberg roles.
POSTGRES_USER=admin
POSTGRES_PASSWORD=<choose-postgres-password>
AIRFLOW_DB_PASSWORD=<choose-airflow-db-password>
ICEBERG_DB_PASSWORD=<choose-iceberg-db-password>

# MinIO AIStor also requires a valid local minio.license file.
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=<choose-minio-password-at-least-8-characters>

# CloudBeaver first-run administrator; not the Trino database user.
CLOUDBEAVER_ADMIN_USER=cbadmin
CLOUDBEAVER_ADMIN_PASSWORD=<choose-mixed-case-password-with-a-number>

# Used only when starting Grafana/Airflow; keep non-placeholder passwords.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=<choose-grafana-password>
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=<choose-airflow-admin-password>
AIRFLOW_UID=50000

# Generate these before starting Airflow; not needed for the SQL-only stack.
AIRFLOW_FERNET_KEY=
AIRFLOW_JWT_SECRET=
