# Không bắt buộc. Copy thành .env nếu muốn đổi mật khẩu Grafana (chỉ có tác dụng ở lần chạy Grafana đầu tiên).
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# Chế độ Serving: demo (mặc định trong thư mục này) hoặc trino (cần repo đầy đủ có Trino)
SERVING_SOURCE=demo

# Replay chế độ demo
DEMO_START=2025-10-07 05:00
DEMO_SPEED=20
